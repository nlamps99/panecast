{
  "expo": {
    "name": "Panecast",
    "slug": "panecast",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "panecast",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.nzx.panecast",
      "buildNumber": "8",
      "supportsTablet": true,
      "icon": "./assets/panecast.icon",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "在同一个 Wi-Fi 下直接连接电脑上的 relay",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.nzx.panecast",
      "versionCode": 8,
      "adaptiveIcon": {
        "backgroundColor": "#182335",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a1b26",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/GeistMono-Regular.ttf",
            "./assets/fonts/GeistMono-Bold.ttf"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "扫描电脑上显示的配对二维码",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "选择要发到电脑上的图片",
          "cameraPermission": "扫描配对二维码，或拍照发到电脑上",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": true,
          "color": "#1a1b26"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#1a1b26"
  }
}
