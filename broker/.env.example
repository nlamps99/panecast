# Public DNS name whose A/AAAA record points at this VPS.
CMUX_BROKER_DOMAIN=relay.example.com

# Computers are enrolled automatically: `panecast setup` signs in with an
# account and the broker assigns a relay id, relay token and pairing code.
# Set to 0 to disable enrollment and only accept the relays configured below.
# CMUX_RELAY_ENROLLMENT=0

# Optional fixed relay (e.g. an existing cmux-relay). The same relay id and
# relay token go into the Mac's relay.json. Leave all three unset to rely on
# enrollment only.
# CMUX_RELAY_ID=home-mac
# CMUX_RELAY_TOKEN=replace-with-a-long-random-secret
# CMUX_PAIRING_CODE=replace-with-a-different-long-random-secret

# For multiple fixed computers, use relays.example.json and docker-compose.multi.yml.
# The overlay sets CMUX_RELAYS_FILE=/etc/panecast/relays.json and the three
# single-relay variables above are ignored. Without Docker, set CMUX_RELAYS_FILE
# to an absolute local path. CMUX_RELAYS_JSON is an alternative JSON object;
# do not set it together with CMUX_RELAYS_FILE.
